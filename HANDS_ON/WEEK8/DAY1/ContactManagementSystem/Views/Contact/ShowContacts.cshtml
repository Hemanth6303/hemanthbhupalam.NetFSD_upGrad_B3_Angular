
@model List<ContactManagementSystem.Models.ContactInfo>

<h2>Contacts</h2>
<a asp-action="AddContact">Add</a>

<table border="1">
    <tr>
        <th>Name</th>
        <th>Company</th>
        <th>Department</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FirstName @item.LastName</td>
            <td>@item.CompanyName</td>
            <td>@item.DepartmentName</td>
            <td>
                <a asp-action="EditContact" asp-route-id="@item.ContactId">Edit</a>
                <a asp-action="DeleteContact" asp-route-id="@item.ContactId">Delete</a>
            </td>
        </tr>
    }
</table>